rules_version = '2';

// SPAR Malta Hub — database rules.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Who gets in is decided by the "members" collection: one document per
// person, named by their email (lower case), with a "role" of:
//   admin — everything, plus manage who has access
//   edit  — read and change data in all tools
//   view  — read only
// Anyone not listed gets nothing, even with a valid login.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberDoc());
    }
    function myRole() {
      return get(memberDoc()).data.role;
    }
    function canWrite() {
      return isMember() && myRole() in ['admin', 'edit'];
    }
    function isAdmin() {
      return isMember() && myRole() == 'admin';
    }

    // Access list. Members may read their own entry (to log in);
    // only admins see or change the full list.
    match /members/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'edit', 'view']
        && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();   // can't lock yourself out
    }

    // Display names, so tools can show who did what.
    match /profiles/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Shared tool data (checklist ticks, unders, cash reports, …).
    match /apps/{tool}/{rest=**} {
      allow read: if isMember();
      allow write: if canWrite();
    }

    // Each person's private tool data — nobody else can read it.
    match /private/{uid}/{rest=**} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Everything else is closed.
  }
}
