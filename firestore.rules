rules_version = '2';

// SPAR Malta Hub — database rules (version 2: store-based access).
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Who gets in is decided by the "members" collection: one document per
// person, named by their email (lower case), with:
//   role   — admin   : everything, plus manage people and stores
//            hq      : Head Office — sees all stores, posts DAPs, sets module settings
//            support : support teams — sees and works in all stores
//            rom     : Regional Operations Manager — their own stores
//            sm      : Store Manager — their own store
//   stores — list of store codes (for rom and sm), e.g. ["MXK","SLM"]
// Anyone not listed gets nothing, even with a valid login.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberDoc());
    }
    function me() {
      return get(memberDoc()).data;
    }
    function role() {
      return me().role;
    }
    function isAdmin() {
      return isMember() && role() == 'admin';
    }
    function isHQ() {
      return isMember() && role() in ['admin', 'hq'];
    }
    function seesAll() {
      return role() in ['admin', 'hq', 'support'];
    }
    function hasStore(code) {
      return isMember() && (seesAll() || (me().stores is list && code in me().stores));
    }

    // ── People ──
    match /members/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'hq', 'support', 'rom', 'sm']
        && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();   // can't lock yourself out
    }

    // Display names, so modules can show who did what.
    match /profiles/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // ── Store list (from the Store Mapping) ──
    match /stores/{code} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ── Modules ──
    // Store data: each store's records, seen only by people with that store.
    match /modules/{module}/stores/{code}/{rest=**} {
      allow read: if hasStore(code);
      allow write: if module != 'dap' && hasStore(code);
    }
    // Module settings (checklist templates, product lists…): everyone reads, Head Office edits.
    match /modules/{module}/config/{rest=**} {
      allow read: if isMember();
      allow write: if isHQ();
    }

    // DAP: Head Office posts; stores can only tick off and add a note.
    match /modules/dap/stores/{code}/posts/{id} {
      allow read: if hasStore(code);
      allow create, delete: if isHQ();
      allow update: if isHQ() || (hasStore(code)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['done', 'note', 'status', 'ackBy', 'ackName', 'ackAt', 'seenAt']));
    }

    // ── Earlier tools moved from claude.ai (Keith's Shop Tracker, Gap Check) ──
    match /apps/{tool}/{rest=**} {
      allow read: if isMember() && role() != 'sm';
      allow write: if isMember() && role() in ['admin', 'hq', 'support', 'rom'];
    }

    // Each person's private settings — nobody else can read them.
    match /private/{uid}/{rest=**} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Everything else is closed.
  }
}
